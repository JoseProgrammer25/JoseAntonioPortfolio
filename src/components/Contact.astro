---
import { Icon } from "astro-icon/components";
---

<main id="contact" class="bg-[#1E293B] py-16">
  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
    <div class="mb-10 md:mb-12">
      <h1 class="text-3xl md:text-4xl text-white font-semibold">Contacto</h1>
      <p class="text-gray-300 mt-3 md:mt-4 text-sm md:text-base">
        Ponte en contacto conmigo.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 items-stretch">
      <div class="bg-[#253040] rounded-xl p-6 md:p-8 flex flex-col">
        <h2 class="text-white text-xl md:text-2xl mb-6">Envíame un mensaje</h2>
        <form id="contactForm" class="space-y-4 flex flex-col grow">
          <div>
            <label class="text-gray-300 text-sm">Nombre</label>
            <input
              type="text"
              name="name"
              required
              placeholder="Tu nombre"
              class="w-full mt-1 p-3 rounded-lg bg-[#1E293B] border border-gray-600 text-white focus:ring-2 focus:ring-orange-400 outline-none"
            />
          </div>
          <div>
            <label class="text-gray-300 text-sm">Email</label>
            <input
              type="email"
              name="email"
              required
              placeholder="tu@email.com"
              class="w-full mt-1 p-3 rounded-lg bg-[#1E293B] border border-gray-600 text-white focus:ring-2 focus:ring-orange-400 outline-none"
            />
          </div>
          <div class="grow">
            <label class="text-gray-300 text-sm">Mensaje</label>
            <textarea
              name="message"
              required
              rows="4"
              placeholder="Tu mensaje..."
              class="w-full mt-1 p-3 rounded-lg bg-[#1E293B] border border-gray-600 text-white focus:ring-2 focus:ring-orange-400 outline-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-orange-400 text-black font-bold py-3 rounded-xl hover:opacity-90 transition"
          >
            Enviar
          </button>
        </form>
      </div>

      <div
        class="bg-[#253040] rounded-xl p-6 md:p-8 flex flex-col justify-center"
      >
        <h2 class="text-white text-xl md:text-2xl mb-8">Mis perfiles</h2>
        <div class="space-y-4">
          <a
            href="https://www.linkedin.com/in/jose-antonio-becerra-morilla-a5a674375/"
            class="flex items-center gap-4 p-4 bg-[#1E293B] rounded-xl hover:bg-[#334155] transition text-white"
          >
            <Icon name="mdi:linkedin" class="text-3xl text-orange-400" />
            <div>
              <p class="font-bold">LinkedIn</p>
              <p class="text-sm text-gray-400">Conectemos profesionalmente</p>
            </div>
          </a>
          <a
            href="https://www.infojobs.net/candidate/cv/view/index.xhtml"
            class="flex items-center gap-4 p-4 bg-[#1E293B] rounded-xl hover:bg-[#334155] transition text-white"
          >
            <Icon name="mdi:briefcase" class="text-3xl text-teal-400" />
            <div>
              <p class="font-bold">InfoJobs</p>
              <p class="text-sm text-gray-400">Revisa mi trayectoria</p>
            </div>
          </a>
          <a
            href="https://github.com/JoseProgrammer25"
            class="flex items-center gap-4 p-4 bg-[#1E293B] rounded-xl hover:bg-[#334155] transition text-white"
          >
            <Icon name="mdi:github" class="text-3xl text-white" />
            <div>
              <p class="font-bold">GitHub</p>
              <p class="text-sm text-gray-400">Explora mi código</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        form.reset();
      } else {
        alert("Hubo un error al enviar el mensaje.");
      }
    } catch (error) {
      console.error(error);
    }
  });
</script>