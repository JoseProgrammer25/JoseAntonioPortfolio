---
import "../styles/global.css";
---

<header class="bg-[#1E293B] w-full border-b-2 border-black">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between px-6 py-4 gap-4">
        
        <div class="shrink-0">
            <h1 class="text-[#00E5FF] font-bold text-2xl">
                <a href="#">JABM.dev</a>
            </h1>
        </div>

        <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-white text-sm md:text-base">
            <a href="#home" class="hover:text-[#00E5FF] duration-300">Inicio</a>
            <a href="#stack" class="hover:text-[#00E5FF] duration-300">Stack</a>
            <a href="#" class="hover:text-[#00E5FF] duration-300">Proyectos</a>
            <a href="#" class="hover:text-[#00E5FF] duration-300">Contacto</a>
        </nav>

        <div class="shrink-0">
            <a href="#" class="px-5 py-2 bg-[#00E5FF] hover:bg-[#00daf3] duration-300 rounded-full text-black font-semibold text-sm">
                Contratarme
