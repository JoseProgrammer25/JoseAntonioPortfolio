---
import "../styles/global.css";
import { Image } from "astro:assets";
import fotoJose from "../assets/joseAntonioBecerra.png";
---

<main class="bg-[#1E293B]">
  <div class="flex flex-row">
    <div
      class="relative left-0 text-center mt-8 ml-24 mb-4 flex flex-col gap-2 justify-center items-center"
    >
      <Image
        src={fotoJose}
        height={350}
        class="rounded-full"
        alt="Foto de Jose Antonio Becerra Morilla"
      />

      <h1 class="text-[#00E5FF] text-5xl">Jose Antonio</h1>
      <h2 class="text-[#F8FAFC] text-xl">Desarrollador Full Stack</h2>

      <div class="flex flex-row gap-2">
        <a class="text-[#F8FAFC] p-1 border-2 rounded-xl">Huelva, España</a>
      </div>
    </div>

    <div>
        
    </div>
  </div>
</main>
