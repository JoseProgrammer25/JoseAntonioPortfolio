---
import "../styles/global.css";
import { Image } from "astro:assets";
import fotoJose from "../assets/joseAntonioBecerra.png";
import { Icon } from "astro-icon/components";
---

<main
  id="home"
  class="bg-[#1E293B] min-h-screen p-4 sm:p-8 flex items-center justify-center"
>
  <div
    class="grid grid-cols-1 lg:grid-cols-12 gap-8 w-full max-w-350 mx-auto items-center"
  >
    <div
      class="lg:col-span-4 flex flex-col gap-3 justify-center items-center text-center"
    >
      <Image
        src={fotoJose}
        height={300}
        class="rounded-full object-cover shadow-xl w-48 h-48 sm:w-64 sm:h-64 lg:w-72 lg:h-72"
        alt="Foto de Jose Antonio Becerra Morilla"
      />

      <h1 class="text-[#00E5FF] text-4xl sm:text-5xl font-bold mt-2">
        Jose Antonio
      </h1>
      <h2 class="text-[#F8FAFC] text-lg sm:text-xl">
        Desarrollador Full Stack
      </h2>

      <div class="flex flex-row gap-2 mt-2">
        <span
          class="text-[#F8FAFC] flex justify-center items-center gap-2 px-4 py-1 border-2 border-gray-400 rounded-xl text-sm sm:text-base transition-colors hover:bg-gray-700/50 cursor-default"
        >
          <Icon name="material-symbols:location-on" /> Huelva, España
        </span>
      </div>
    </div>

    <div class="lg:col-span-8 w-full min-w-0 flex items-center justify-center">
      <div
        class="w-full bg-[#1E1E1E] rounded-xl shadow-2xl overflow-hidden border border-gray-700/50"
      >
        <div class="bg-[#2D2D2D] px-4 py-3 flex items-center justify-between">
          <div class="flex space-x-2">
            <div class="w-3 h-3 rounded-full bg-[#FF5F56]"></div>
            <div class="w-3 h-3 rounded-full bg-[#FFBD2E]"></div>
            <div class="w-3 h-3 rounded-full bg-[#27C93F]"></div>
          </div>
          <div class="text-gray-400 text-xs font-mono opacity-80">
            developer_profile.ts
          </div>
          <div class="w-10"></div>
        </div>

        <div class="p-4 sm:p-6 overflow-x-auto">
          <pre
            class="font-mono leading-loose text-white whitespace-pre text-[11px] sm:text-xs md:text-sm lg:text-base">
<span class="text-[#FF79C6]">class</span> <span class="text-[#50FA7B]">Developer</span> &#123;
  <span class="text-[#FF79C6]">readonly</span> <span class="text-[#8BE9FD]">name</span>: <span class="text-[#8BE9FD]">string</span> = <span class="text-[#F1FA8C]">'J.A. Becerra'</span>;
  <span class="text-[#FF79C6]">readonly</span> <span class="text-[#8BE9FD]">role</span>: <span class="text-[#8BE9FD]">string</span> = <span class="text-[#F1FA8C]">'Full Stack Developer'</span>;

  <span class="text-[#FF79C6]">private</span> <span class="text-[#8BE9FD]">frontendStack</span>: <span class="text-[#8BE9FD]">string</span>[] = [<span class="text-[#F1FA8C]">'Vue'</span>, <span class="text-[#F1FA8C]">'React'</span>, <span class="text-[#F1FA8C]">'JavaScript'</span>, <span class="text-[#F1FA8C]">'TypeScript'</span>];
  <span class="text-[#FF79C6]">private</span> <span class="text-[#8BE9FD]">backendStack</span>: <span class="text-[#8BE9FD]">string</span>[] = [<span class="text-[#F1FA8C]">'NestJS'</span>, <span class="text-[#F1FA8C]">'PHP'</span>, <span class="text-[#F1FA8C]">'Java'</span>];
  <span class="text-[#FF79C6]">private</span> <span class="text-[#8BE9FD]">infrastructure</span>: <span class="text-[#8BE9FD]">string</span>[] = [<span class="text-[#F1FA8C]">'Docker'</span>, <span class="text-[#F1FA8C]">'PostgreSQL'</span>, <span class="text-[#F1FA8C]">'MySQL'</span>];

  <span class="text-[#50FA7B]">getStack</span>() &#123;
    <span class="text-[#FF79C6]">return</span> &#123;
      <span class="text-[#8BE9FD]">frontend</span>: <span class="text-[#FF79C6]">this</span>.<span class="text-[#8BE9FD]">frontendStack</span>,
      <span class="text-[#8BE9FD]">backend</span>: <span class="text-[#FF79C6]">this</span>.<span class="text-[#8BE9FD]">backendStack</span>,
      <span class="text-[#8BE9FD]">database_ops</span>: <span class="text-[#FF79C6]">this</span>.<span class="text-[#8BE9FD]">infrastructure</span>
    &#125;;
  &#125;

  <span class="text-[#50FA7B]">buildApp</span>() &#123;
    <span class="text-[#FF79C6]">return new</span> <span class="text-[#50FA7B]">ScalableSolution</span>(<span class="text-[#FF79C6]">this</span>.<span class="text-[#50FA7B]">getStack</span>());
  &#125;
&#125;</pre>
        </div>
      </div>
    </div>
  </div>
</main>
