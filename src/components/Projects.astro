---
import { Image } from "astro:assets";
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import fotoPortfolio from "../assets/portfolio.png";
import fotoSubszero from "../assets/subszero.png";
---

<main id="projects" class="bg-[#1E293B] py-16">
  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
    <div class="mb-10 md:mb-12">
      <h1 class="text-3xl md:text-4xl text-white font-semibold">Proyectos</h1>
      <p class="text-gray-300 mt-3 md:mt-4 text-sm md:text-base">
        Proyectos realizados con las tecnologías usadas.
      </p>
    </div>

    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 items-stretch w-full"
    >
      <div class="bg-[#253040] rounded-xl flex flex-col justify-between">
        <div class="flex items-center px-6 pt-6 md:px-8 md:pt-8 gap-3">
          <h1 class="text-white text-xl md:text-2xl">Portfolio Personal</h1>
        </div>
        <Image
          src={fotoPortfolio}
          height={400}
          class="p-2"
          alt="Imagen del proyecto portfolio realizado por Jose Antonio"
        />

        <div class="px-6 md:px-8 mt-5 mb-5">
          <ul class="grid grid-cols-2 text-gray-200 gap-y-2 gap-x-4">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>Astro
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-400"
              ></span>TailwindCSS
            </li>
          </ul>
        </div>

        <div class="grid grid-cols-2 gap-2 justify-center items-center">
          <div
            class="flex flex-row gap-2 items-center mx-4 mt-4 mb-4 w-fit bg-orange-400 rounded-xl p-1 md:p-2"
          >
            <Icon name="mdi:github" class="text-2xl" />
            <a href="https://github.com/JoseProgrammer25/JoseAntonioPortfolio"
              >Ver en Github</a
            >
          </div>

          <div
            class="flex flex-row gap-2 items-center mx-4 mt-4 mb-4 w-fit bg-teal-400 rounded-xl p-1 md:p-2"
          >
            <Icon name="material-symbols:book-2" class="text-2xl" />
            <a href="https://github.com/JoseProgrammer25/JoseAntonioPortfolio"
              >Ver Proyecto</a
            >
          </div>
        </div>
      </div>

      <div class="bg-[#253040] rounded-xl flex flex-col justify-between">
        <div class="flex items-center px-6 pt-6 md:px-8 md:pt-8 gap-3">
          <h1 class="text-white text-xl md:text-2xl">Portfolio Personal</h1>
        </div>
        <Image
          src={fotoSubszero}
          height={400}
          class="p-2"
          alt="Imagen del proyecto portfolio realizado por Jose Antonio"
        />

        <div class="px-6 md:px-8 mt-5 mb-5">
          <ul class="grid grid-cols-2 text-gray-200 gap-y-2 gap-x-4">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>PHP
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-400"
              ></span>TailwindCSS
            </li>
          </ul>
        </div>

        <div class="grid grid-cols-1 gap-2 justify-center items-center">
          <div
            class="flex flex-row gap-2 items-center mx-4 mt-4 mb-4 w-fit bg-teal-400 rounded-xl p-1 md:p-2"
          >
            <Icon name="material-symbols:book-2" class="text-2xl" />
            <a href="https://subszero.infinityfree.me/"
              >Ver Proyecto</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
